# Normalize line endings to LF in the repository, CRLF on checkout for Windows
* text=auto eol=lf

# Explicitly keep these as LF everywhere
*.js   text eol=lf
*.jsx  text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.env  text eol=lf
*.py   text eol=lf

# Binary files — never convert
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
